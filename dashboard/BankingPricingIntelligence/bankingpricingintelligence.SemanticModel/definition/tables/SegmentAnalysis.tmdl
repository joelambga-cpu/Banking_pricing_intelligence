table SegmentAnalysis
	lineageTag: 05dcaa28-0cba-4fc9-8c01-a582cfe2ee33

	measure 'Clienti Target' =
			
			SUM(SegmentAnalysis[target_customers])
		formatString: 0
		lineageTag: edd68d76-9c58-4a17-a854-27376eabce17

	measure 'Depositi Target' =
			
			SUM(SegmentAnalysis[target_deposits_eur])
		lineageTag: ba6d4e3c-f198-4540-beb9-2d66704beedc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo annuo targeted (25bps)' =
			
			SUM(SegmentAnalysis[targeted_25bps_cost_eur])
		lineageTag: 4318d72c-fa16-4d1f-b410-fade2ca6c4c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Segment Depositi target mln EUR' = DIVIDE([Depositi Target], 1000000)
		formatString: 0.00" mln €"
		displayFolder: Segment Analysis
		lineageTag: c42354c2-2e35-5450-831e-5ff5e782f7b9

	measure 'Segment Costo targeted mila EUR' = DIVIDE([Costo annuo targeted (25bps)], 1000)
		formatString: 0.0" mila €"
		displayFolder: Segment Analysis
		lineageTag: 78680baa-de49-56d1-b5cc-ab8404af8bd2

	measure 'Segment Quota clienti target' = DIVIDE(SUM(SegmentAnalysis[target_customers]), SUM(SegmentAnalysis[total_customers]))
		formatString: 0.0%
		displayFolder: Segment Analysis
		lineageTag: dd23c833-90c2-5b45-88be-723e2518b35d

	measure 'Segment Quota depositi target' = DIVIDE(SUM(SegmentAnalysis[target_deposits_eur]), SUM(SegmentAnalysis[total_deposits_eur]))
		formatString: 0.0%
		displayFolder: Segment Analysis
		lineageTag: d6c3532b-e083-562a-82b5-265d5367b8b5

	measure 'Segment Quota clienti in calo' = DIVIDE(SUM(SegmentAnalysis[declining_customers]), SUM(SegmentAnalysis[total_customers]))
		formatString: 0.00%
		displayFolder: Segment Analysis
		lineageTag: e876aae4-598b-449d-97d2-b44e5dff50ef

	measure 'Segment Deflusso proxy mln EUR' = DIVIDE(SUM(SegmentAnalysis[outflow_proxy_eur]), 1000000)
		formatString: 0.00" mln €"
		displayFolder: Segment Analysis
		lineageTag: ad8da782-d01e-4895-a5b8-9f8b7bc71e80

	measure 'Segment Deflusso proxy su depositi' = DIVIDE(SUM(SegmentAnalysis[outflow_proxy_eur]), SUM(SegmentAnalysis[total_deposits_eur]))
		formatString: 0.00%
		displayFolder: Segment Analysis
		lineageTag: 84e67fa3-324e-4f00-93f7-b1989a66f352

	measure 'Esposizione deflussi %' =
			
			DIVIDE(
			    SUM(SegmentAnalysis[outflow_proxy_eur]),
			    SUM(SegmentAnalysis[total_deposits_eur])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 61dc00c9-0052-4104-a80b-75255ba1b3fc

