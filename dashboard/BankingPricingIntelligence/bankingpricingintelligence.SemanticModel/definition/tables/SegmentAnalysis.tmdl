	partition SegmentAnalysis = m
		mode: import
		source =
				let
				    Origine = Csv.Document(
				        File.Contents("C:\Users\joela\Desktop\01.DATA BI\1.Progetti attivi\banking-pricing-intelligence\data\analytics\segment_pricing_analysis.csv"),
				        [Delimiter=",", Columns=14, Encoding=1252, QuoteStyle=QuoteStyle.None]
				    ),
				
				    #"Intestazioni alzate di livello" = Table.PromoteHeaders(
				        Origine,
				        [PromoteAllScalars=true]
				    ),
				
				    #"Modificato tipo" = Table.TransformColumnTypes(
				        #"Intestazioni alzate di livello",
				        {
				            {"segment", type text},
				            {"total_customers", Int64.Type},
				            {"target_customers", Int64.Type},
				            {"target_customer_pct", type number},
				            {"total_deposits_eur", type number},
				            {"target_deposits_eur", type number},
				            {"target_deposit_pct", type number},
				            {"target_avg_outflow_90d_pct", type number},
				            {"targeted_25bps_cost_eur", type number},
				            {"declining_customers", Int64.Type},
				            {"declining_customer_pct", type number},
				            {"outflow_proxy_eur", type number},
				            {"outflow_proxy_pct_of_deposits", type number},
				            {"target_outflow_proxy_eur", type number}
				        },
				        "en-US"
				    )
				in
				    #"Modificato tipo"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigazione

