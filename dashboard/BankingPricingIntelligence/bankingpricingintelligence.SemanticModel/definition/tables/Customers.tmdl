table Customers
	lineageTag: 312ed768-c4fe-4bfd-bc8f-6bff23cb4445

	measure 'Tasso Medio Ponderato Portafoglio' =
			
			DIVIDE(
			    SUMX(
			        Customers,
			        Customers[deposit_balance_eur] *
			        Customers[current_deposit_rate_pct]
			    ),
			    SUM(Customers[deposit_balance_eur])
			)
		lineageTag: ad4c2130-b1ec-4ffb-9933-1117a92ad09b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column customer_id
		dataType: string
		lineageTag: 4a1ca4e1-c04a-4e74-8594-94b129966801
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	column segment
		dataType: string
		lineageTag: 93727d64-a894-425a-ad68-fc584ae0233b
		summarizeBy: none
		sourceColumn: segment

		annotation SummarizationSetBy = Automatic

	column deposit_balance_eur
		dataType: double
		formatString: 0
		lineageTag: 44c710f8-4d62-4a5a-9fbc-69d3e0f054b6
		summarizeBy: sum
		sourceColumn: deposit_balance_eur

		annotation SummarizationSetBy = Automatic

	column current_deposit_rate_pct
		dataType: double
		formatString: 0
		lineageTag: 6aa158fc-07ed-4a02-9f1e-fd2220c7264d
		summarizeBy: sum
		sourceColumn: current_deposit_rate_pct

		annotation SummarizationSetBy = Automatic

	column deposit_change_90d_pct
		dataType: double
		formatString: 0
		lineageTag: 5851d02f-bdda-45bf-a578-975d22c3a0ad
		summarizeBy: sum
		sourceColumn: deposit_change_90d_pct

		annotation SummarizationSetBy = Automatic

	column product_count
		dataType: string
		lineageTag: 08e2239f-143d-4623-b1ba-5450bef4a029
		summarizeBy: none
		sourceColumn: product_count

		annotation SummarizationSetBy = Automatic

	column tenure_months
		dataType: string
		lineageTag: c15abba7-8e1d-4fe6-845c-438a7be8b38c
		summarizeBy: none
		sourceColumn: tenure_months

		annotation SummarizationSetBy = Automatic

	column has_mortgage
		dataType: string
		lineageTag: ef9d7f1c-464d-45b5-be3d-366f9315b8b4
		summarizeBy: none
		sourceColumn: has_mortgage

		annotation SummarizationSetBy = Automatic

	partition Customers = m
		mode: import
		source =
				let
				    Origine = Csv.Document(
				        File.Contents("C:\Users\joela\Desktop\01.DATA BI\1.Progetti attivi\banking-pricing-intelligence\data\simulated\customer_portfolio.csv"),
				        [Delimiter=",", Columns=8, Encoding=1252, QuoteStyle=QuoteStyle.None]
				    ),
				    #"Intestazioni alzate di livello" = Table.PromoteHeaders(
				        Origine,
				        [PromoteAllScalars=true]
				    ),
				    #"Modificato tipo" = Table.TransformColumnTypes(
				        #"Intestazioni alzate di livello",
				        {
				            {"deposit_balance_eur", type number},
				            {"current_deposit_rate_pct", type number},
				            {"deposit_change_90d_pct", type number}
				        },
				        "en-US"
				    )
				in
				    #"Modificato tipo"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigazione

