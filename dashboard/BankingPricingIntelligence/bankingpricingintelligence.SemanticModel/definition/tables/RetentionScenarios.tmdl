table RetentionScenarios
	lineageTag: 30d22689-3fe6-4250-8d16-e5b71adf89c6

	measure 'Scenario Costo annuo EUR' = SUMX(VALUES(RetentionScenarios[strategy]), CALCULATE(MAX(RetentionScenarios[annual_repricing_cost_eur])))
		formatString: #,0.00
		displayFolder: Retention Scenarios
		lineageTag: 3508716a-4f0d-5764-9605-3495d59c51e3

	measure 'Scenario Depositi trattenuti EUR' = IF(HASONEVALUE(RetentionScenarios[scenario]), SUM(RetentionScenarios[estimated_deposits_retained_eur]))
		formatString: #,0.00
		displayFolder: Retention Scenarios
		lineageTag: 2367259c-e646-547f-b799-8f42aed72373

	measure 'Scenario Costo per EUR' = DIVIDE([Scenario Costo annuo EUR], [Scenario Depositi trattenuti EUR])
		formatString: 0.0000
		displayFolder: Retention Scenarios
		lineageTag: 6f11fea6-a3a6-5835-8d5b-c4aa1bb72134

	measure 'Scenario Ipotesi retention' = IF(HASONEVALUE(RetentionScenarios[scenario]), DIVIDE(SUM(RetentionScenarios[estimated_deposits_retained_eur]), SUM(RetentionScenarios[outflow_proxy_eur])))
		formatString: 0%
		displayFolder: Retention Scenarios
		lineageTag: f8972f02-8115-5495-ae2b-8dfddebf99c2

	measure 'Scenario Clienti trattati' = SUMX(VALUES(RetentionScenarios[strategy]), CALCULATE(MAX(RetentionScenarios[customers_treated])))
		formatString: #,0
		displayFolder: Retention Scenarios
		lineageTag: 2c55296a-c2bc-5d24-be0d-7fa3bae8a3ef

	measure 'Scenario Costo mila EUR' = DIVIDE([Scenario Costo annuo EUR], 1000)
		formatString: 0.0
		displayFolder: Retention Scenarios
		lineageTag: 1265e4eb-1795-5348-9799-d85cfd9c95ec

	measure 'Scenario Depositi mln EUR' = DIVIDE([Scenario Depositi trattenuti EUR], 1000000)
		formatString: 0.00
		displayFolder: Retention Scenarios
		lineageTag: 170a99ba-aa59-594a-9dab-9d95677748f1

	measure 'Scenario Blanket mln EUR' = CALCULATE([Scenario Depositi mln EUR], RetentionScenarios[strategy] = "BLANKET")
		formatString: 0.00
		displayFolder: Retention Scenarios
		lineageTag: 934ea28a-35d8-5fbf-b671-1a12fcb97e56

	measure 'Scenario Targeted mln EUR' = CALCULATE([Scenario Depositi mln EUR], RetentionScenarios[strategy] = "TARGETED")
		formatString: 0.00
		displayFolder: Retention Scenarios
		lineageTag: ec41d1b6-cbce-56a8-8215-d2b473825070

	measure 'Scenario Blanket costo unitario' = CALCULATE([Scenario Costo per EUR], RetentionScenarios[strategy] = "BLANKET")
		formatString: 0.0000
		displayFolder: Retention Scenarios
		lineageTag: 83737bfa-b70b-53f9-910b-1499e04e687c

	measure 'Scenario Targeted costo unitario' = CALCULATE([Scenario Costo per EUR], RetentionScenarios[strategy] = "TARGETED")
		formatString: 0.0000
		displayFolder: Retention Scenarios
		lineageTag: 31b89886-ee73-5e8c-a1cd-a9a896a8e555

	measure 'Scenario Base targeted mln EUR' = CALCULATE([Scenario Targeted mln EUR], RetentionScenarios[scenario] = "BASE")
		formatString: 0.00" mln €"
		displayFolder: Retention Scenarios
		lineageTag: 71504e01-cc0e-5617-847b-dd15cfe75bde

	measure 'Scenario Targeted costo annuo mila EUR' = CALCULATE([Scenario Costo mila EUR], RetentionScenarios[strategy] = "TARGETED")
		formatString: 0.0" mila €"
		displayFolder: Retention Scenarios
		lineageTag: 009d2eac-6733-51fb-b848-ac1d68dd7e50

	measure 'Scenario Base riduzione costo unitario' = CALCULATE(1 - DIVIDE([Scenario Targeted costo unitario], [Scenario Blanket costo unitario]), RetentionScenarios[scenario] = "BASE")
		formatString: 0.0%
		displayFolder: Retention Scenarios
		lineageTag: 2e97f1a2-2dba-5d98-a98c-b290a45e99e1

