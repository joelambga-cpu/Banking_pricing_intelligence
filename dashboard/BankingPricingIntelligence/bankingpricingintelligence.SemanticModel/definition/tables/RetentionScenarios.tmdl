		annotation SummarizationSetBy = Automatic

	partition RetentionScenarios = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents("C:\Users\joela\Desktop\01.DATA BI\1.Progetti attivi\banking-pricing-intelligence\data\analytics\retention_scenarios.csv"),[Delimiter=",", Columns=7, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Intestazioni alzate di livello" = Table.PromoteHeaders(Origine, [PromoteAllScalars=true]),
				    #"Modificato tipo" = Table.TransformColumnTypes(
				    #"Intestazioni alzate di livello",
				    {
				        {"strategy", type text},
				        {"scenario", type text},
				        {"customers_treated", Int64.Type},
				        {"annual_repricing_cost_eur", type number},
				        {"outflow_proxy_eur", type number},
				        {"estimated_deposits_retained_eur", type number},
				        {"cost_per_eur_retained", type number}
				    },
				    "en-US"
				)
				in
				    #"Modificato tipo"

	annotation PBI_ResultType = Table

