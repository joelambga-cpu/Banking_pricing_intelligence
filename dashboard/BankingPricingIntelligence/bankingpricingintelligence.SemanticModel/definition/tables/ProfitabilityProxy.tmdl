table ProfitabilityProxy
	lineageTag: 3a07c953-c515-4f0d-b61a-3c50f02cd155

	measure 'Spread Preservato vs Blanket' =
			
			MAX(ProfitabilityProxy[targeted_spread_proxy_pp])
			-
			MAX(ProfitabilityProxy[blanket_spread_proxy_pp])
		formatString: 0.00
		lineageTag: 21a94add-6851-459c-a981-19df2f6d3e9c

	column baseline_deposit_rate_pct
		dataType: double
		formatString: 0
		lineageTag: c9d3ab85-2cde-4a3e-8465-e4b5d5361c8e
		summarizeBy: sum
		sourceColumn: baseline_deposit_rate_pct

		annotation SummarizationSetBy = Automatic

	column blanket_deposit_rate_pct
		dataType: double
		formatString: 0
		lineageTag: 837dc1cc-3ec8-452d-bb37-07136ff817fe
		summarizeBy: sum
		sourceColumn: blanket_deposit_rate_pct

		annotation SummarizationSetBy = Automatic

	column targeted_deposit_rate_pct
		dataType: double
		formatString: 0
		lineageTag: 7849b03a-9212-4078-9a44-fc02c0d3b693
		summarizeBy: sum
		sourceColumn: targeted_deposit_rate_pct

		annotation SummarizationSetBy = Automatic

	column baseline_spread_proxy_pp
		dataType: double
		formatString: 0.00
		lineageTag: e079792a-1c6a-44d2-b340-be25bc78ec91
		summarizeBy: sum
		sourceColumn: baseline_spread_proxy_pp

		annotation SummarizationSetBy = Automatic

	column blanket_spread_proxy_pp
		dataType: double
		formatString: 0.00
		lineageTag: ebc2e98d-5091-4e9f-b5a4-e2c21b477f8c
		summarizeBy: sum
		sourceColumn: blanket_spread_proxy_pp

		annotation SummarizationSetBy = Automatic

	column targeted_spread_proxy_pp
		dataType: double
		formatString: 0.00
		lineageTag: 097be02a-804b-48e0-8125-4322f756b063
		summarizeBy: sum
		sourceColumn: targeted_spread_proxy_pp

		annotation SummarizationSetBy = Automatic

	partition ProfitabilityProxy = m
		mode: import
		source =
				let
				    Origine = Csv.Document(
				        File.Contents("C:\Users\joela\Desktop\01.DATA BI\1.Progetti attivi\banking-pricing-intelligence\data\analytics\profitability_proxy.csv"),
				        [Delimiter=",", Columns=6, Encoding=1252, QuoteStyle=QuoteStyle.None]
				    ),
				    #"Intestazioni alzate di livello" = Table.PromoteHeaders(
				        Origine,
				        [PromoteAllScalars=true]
				    ),
				    #"Modificato tipo" = Table.TransformColumnTypes(
				        #"Intestazioni alzate di livello",
				        {
				            {"baseline_deposit_rate_pct", type number},
				            {"baseline_spread_proxy_pp", type number},
				            {"blanket_deposit_rate_pct", type number},
				            {"blanket_spread_proxy_pp", type number},
				            {"targeted_deposit_rate_pct", type number},
				            {"targeted_spread_proxy_pp", type number}
				        },
				        "en-US"
				    )
				in
				    #"Modificato tipo"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigazione

