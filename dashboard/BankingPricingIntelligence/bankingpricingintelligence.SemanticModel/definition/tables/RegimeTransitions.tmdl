table RegimeTransitions
	lineageTag: 1a498bd9-d594-4e1a-b3cd-f087b4a3b64c

	measure 'Market Regime ultimo' = VAR D = MAXX(ALL(RegimeTransitions), RegimeTransitions[period]) RETURN CALCULATE(SELECTEDVALUE(RegimeTransitions[pricing_regime]), REMOVEFILTERS(RegimeTransitions), RegimeTransitions[period] = D)
		displayFolder: Market and Regimes
		lineageTag: 44acf13f-f5b6-5009-a3e1-3e9707d479ce

	measure 'Market Regime precedente' = VAR D = MAXX(ALL(RegimeTransitions), RegimeTransitions[period]) RETURN "Mese precedente: " & CALCULATE(SELECTEDVALUE(RegimeTransitions[previous_regime]), REMOVEFILTERS(RegimeTransitions), RegimeTransitions[period] = D)
		displayFolder: Market and Regimes
		lineageTag: 75ede2b7-e517-59ea-a7ae-640fc9aa81e6

	measure 'Market Mesi' = COUNTROWS(RegimeTransitions)
		formatString: 0
		displayFolder: Market and Regimes
		lineageTag: 5fa78200-d943-57fa-bacf-d3b6d3d63210

	measure 'Market Cambi' = CALCULATE(COUNTROWS(RegimeTransitions), RegimeTransitions[regime_status] = "REGIME CHANGE")
		formatString: 0
		displayFolder: Market and Regimes
		lineageTag: 77871e04-6841-548c-ada6-3d9233d97bf5

	measure 'Market Sintesi storico' = FORMAT([Market Mesi], "0") & " MESI  /  " & FORMAT([Market Cambi], "0") & " CAMBI DI REGIME"
		displayFolder: Market and Regimes
		lineageTag: d49ca624-3e9f-5c25-8b21-89aed1dbd5f3

	measure 'Market Strip COMFORTABLE' = IF(SELECTEDVALUE(RegimeTransitions[pricing_regime]) = "COMFORTABLE", 1, BLANK())
		formatString: 0
		displayFolder: Market and Regimes
		lineageTag: 47864ebc-0172-5789-9b44-2e2786b8040c

	measure 'Market Strip FUNDING PRESSURE' = IF(SELECTEDVALUE(RegimeTransitions[pricing_regime]) = "FUNDING PRESSURE", 1, BLANK())
		formatString: 0
		displayFolder: Market and Regimes
		lineageTag: 044354f1-cf15-5c91-a7a4-417641550e82

	measure 'Market Strip MARGIN PRESSURE' = IF(SELECTEDVALUE(RegimeTransitions[pricing_regime]) = "MARGIN PRESSURE", 1, BLANK())
		formatString: 0
		displayFolder: Market and Regimes
		lineageTag: ec643956-bf4a-5c37-a4b4-d1392d5478ea

	measure 'Market Strip CRITICAL PRESSURE' = IF(SELECTEDVALUE(RegimeTransitions[pricing_regime]) = "CRITICAL PRESSURE", 1, BLANK())
		formatString: 0
		displayFolder: Market and Regimes
		lineageTag: 56e6431b-e452-5044-a999-26f80a7391f1

	column period
